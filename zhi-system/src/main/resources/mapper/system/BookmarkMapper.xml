<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhi.system.mapper.BookmarkMapper">

    <resultMap type="Bookmark" id="BookmarkResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="articleId" column="article_id"/>
        <result property="createTime" column="create_time"/>
        <result property="tenantId" column="tenant_id"/>
    </resultMap>

    <sql id="selectBookmarkVo">
        SELECT id, user_id, article_id, create_time, tenant_id FROM zhi_bookmark
    </sql>

    <select id="selectBookmarkList" parameterType="Bookmark" resultMap="BookmarkResult">
        <include refid="selectBookmarkVo"/>
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="articleId != null">
                AND article_id = #{articleId}
            </if>
        </where>
    </select>

    <select id="selectBookmarkById" parameterType="Long" resultMap="BookmarkResult">
        <include refid="selectBookmarkVo"/>
        WHERE id = #{id}
    </select>

    <insert id="insertBookmark" parameterType="Bookmark" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO zhi_bookmark
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="articleId != null">article_id,</if>
            <if test="tenantId != null">tenant_id,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="articleId != null">#{articleId},</if>
            <if test="tenantId != null">#{tenantId},</if>
            NOW()
        </trim>
    </insert>

    <delete id="deleteBookmarkById" parameterType="Long">
        DELETE FROM zhi_bookmark WHERE id = #{id}
    </delete>

    <delete id="deleteBookmarkByUserIdAndArticleId">
        DELETE FROM zhi_bookmark WHERE user_id = #{userId} AND article_id = #{articleId}
    </delete>

    <select id="existsBookmark" resultType="int">
        SELECT COUNT(*) FROM zhi_bookmark WHERE user_id = #{userId} AND article_id = #{articleId}
    </select>

    <select id="selectBookmarksByUserId" parameterType="Long" resultMap="BookmarkResult">
        <include refid="selectBookmarkVo"/>
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectBookmarkArticlesByUserId" parameterType="Long" resultType="java.util.Map">
        SELECT b.id AS bookmarkId,
               b.create_time AS bookmarkTime,
               a.id AS articleId,
               a.title AS title,
               a.summary AS summary,
               a.cover_url AS coverUrl,
               a.author_name AS authorName,
               a.view_count AS viewCount,
               a.like_count AS likeCount,
               a.comment_count AS commentCount
        FROM zhi_bookmark b
        INNER JOIN zhi_article a ON a.id = b.article_id
        WHERE b.user_id = #{userId}
          AND a.status = 1
          AND a.del_flag = '0'
        ORDER BY b.create_time DESC
    </select>

</mapper>
