<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhi.system.mapper.BlogVisitLogMapper">

    <resultMap type="BlogVisitLog" id="BlogVisitLogResult">
        <result property="id"    column="id"    />
        <result property="targetType"    column="target_type"    />
        <result property="targetId"    column="target_id"    />
        <result property="targetTitle"    column="target_title"    />
        <result property="path"    column="path"    />
        <result property="userId"    column="user_id"    />
        <result property="visitorKey"    column="visitor_key"    />
        <result property="ip"    column="ip"    />
        <result property="userAgent"    column="user_agent"    />
        <result property="referer"    column="referer"    />
        <result property="isUnique"    column="is_unique"    />
        <result property="visitDate"    column="visit_date"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <!-- 标题通过 JOIN 文章/页面表获取，不在明细表冗余存储 -->
    <sql id="selectBlogVisitLogVo">
        select v.id, v.target_type, v.target_id, v.path, v.user_id, v.visitor_key, v.ip,
               v.user_agent, v.referer, v.is_unique, v.visit_date, v.create_time,
               coalesce(a.title, p.title) as target_title
        from zhi_visit_log v
        left join zhi_article a on v.target_type = 'article' and a.id = v.target_id
        left join zhi_page p on v.target_type = 'page' and p.id = v.target_id
    </sql>

    <select id="selectBlogVisitLogList" parameterType="BlogVisitLog" resultMap="BlogVisitLogResult">
        <include refid="selectBlogVisitLogVo"/>
        <where>
            <if test="targetType != null and targetType != ''"> and v.target_type = #{targetType}</if>
            <if test="targetId != null"> and v.target_id = #{targetId}</if>
            <if test="ip != null and ip != ''"> and v.ip like concat('%', #{ip}, '%')</if>
            <if test="visitorKey != null and visitorKey != ''"> and v.visitor_key = #{visitorKey}</if>
            <if test="uniqueOnly != null and uniqueOnly == true"> and v.is_unique = 1</if>
            <if test="keyword != null and keyword != ''">
                and (coalesce(a.title, p.title) like concat('%', #{keyword}, '%') or v.path like concat('%', #{keyword}, '%'))
            </if>
            <if test="beginDate != null and beginDate != ''"> and v.visit_date &gt;= #{beginDate}</if>
            <if test="endDate != null and endDate != ''"> and v.visit_date &lt;= #{endDate}</if>
        </where>
        order by v.id desc
    </select>

    <select id="selectVisitLogById" parameterType="Long" resultMap="BlogVisitLogResult">
        <include refid="selectBlogVisitLogVo"/>
        where v.id = #{id}
    </select>

    <!-- 区间汇总：PV=全部明细行，UV=is_unique 行 -->
    <select id="selectVisitSummary" resultType="java.util.Map">
        select
            count(1) as pv,
            coalesce(sum(case when v.is_unique = 1 then 1 else 0 end), 0) as uv,
            count(distinct v.visit_date) as days
        from zhi_visit_log v
        <where>
            <if test="beginDate != null and beginDate != ''"> and v.visit_date &gt;= #{beginDate}</if>
            <if test="endDate != null and endDate != ''"> and v.visit_date &lt;= #{endDate}</if>
        </where>
    </select>

    <select id="selectTopTargets" resultType="java.util.Map">
        select v.target_type as targetType,
               v.target_id as targetId,
               coalesce(a.title, p.title) as title,
               count(1) as pv,
               coalesce(sum(case when v.is_unique = 1 then 1 else 0 end), 0) as uv
        from zhi_visit_log v
        left join zhi_article a on v.target_type = 'article' and a.id = v.target_id
        left join zhi_page p on v.target_type = 'page' and p.id = v.target_id
        <where>
            <if test="beginDate != null and beginDate != ''"> and v.visit_date &gt;= #{beginDate}</if>
            <if test="endDate != null and endDate != ''"> and v.visit_date &lt;= #{endDate}</if>
        </where>
        group by v.target_type, v.target_id, coalesce(a.title, p.title)
        order by pv desc
        limit #{limit}
    </select>

    <insert id="insertBlogVisitLog" parameterType="BlogVisitLog" useGeneratedKeys="true" keyProperty="id">
        insert into zhi_visit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="targetId != null">target_id,</if>
            <if test="path != null">path,</if>
            <if test="userId != null">user_id,</if>
            <if test="visitorKey != null">visitor_key,</if>
            <if test="ip != null">ip,</if>
            <if test="userAgent != null">user_agent,</if>
            <if test="referer != null">referer,</if>
            <if test="isUnique != null">is_unique,</if>
            <if test="visitDate != null">visit_date,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="path != null">#{path},</if>
            <if test="userId != null">#{userId},</if>
            <if test="visitorKey != null">#{visitorKey},</if>
            <if test="ip != null">#{ip},</if>
            <if test="userAgent != null">#{userAgent},</if>
            <if test="referer != null">#{referer},</if>
            <if test="isUnique != null">#{isUnique},</if>
            <if test="visitDate != null">#{visitDate},</if>
         </trim>
    </insert>

    <delete id="deleteBlogVisitLogByIds" parameterType="String">
        delete from zhi_visit_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteBlogVisitLogBefore" parameterType="String">
        delete from zhi_visit_log where visit_date &lt; #{date}
    </delete>

    <delete id="truncateBlogVisitLog">
        delete from zhi_visit_log
    </delete>
</mapper>
