{
  "name": "zhiblog",
  "version": "1.0.0",
  "description": "知企建站系统（ZhiEnterprise）——面向企业官网的建站系统",
  "author": "nevell",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/nevell/zhienterprise.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@types/dompurify": "^3.2.0",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.20.0",
    "clipboard": "2.0.11",
    "dompurify": "^3.3.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.7",
    "fflate": "0.8.3",
    "file-saver": "2.0.5",
    "fuse.js": "6.6.2",
    "highlight.js": "^11.12.0",
    "js-beautify": "1.14.11",
    "js-cookie": "3.0.8",
    "js-yaml": "5.4.2",
    "jsencrypt": "3.5.4",
    "marked": "^12.0.2",
    "nanoid": "6.0.1",
    "nprogress": "0.2.0",
    "pinia": "^3.0.4",
    "postcss-selector-parser": "7.1.6",
    "qrcode": "^1.5.4",
    "splitpanes": "4.1.2",
    "vue": "3.5.43",
    "vue-cropper": "1.1.4",
    "vue-router": "^4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.18.0",
    "eslint-plugin-typescript": "^0.14.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "1.105.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "^7.3.6",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons-ng": "^1.10.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "quill": "2.0.2",
    "braces": ">=3.0.3",
    "postcss": ">=8.4.31",
    "micromatch": ">=4.0.8",
    "svgo": ">=3.3.2",
    "@humanfs/node": ">=0.16.8"
  }
}
