# 页面标题
VITE_APP_TITLE = 知企建站系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 后台/登录/上传等非站点接口的前缀：nginx 的 `location ^~ /prod-api/` 会剥掉该前缀再转发到后端。
# ⚠️ 不要写成 /api：nginx 的 `location ^~ /api/` 是「站点公开 API 原样直通」（/api/** 保留前缀），
# 写成 /api 会让 /captchaImage、/auth/login、/system/**、/common/upload 变成 /api/xxx 而 401，
# 表现为登录页不显示验证码（2026-10 修复）。站点接口自身已写死 /api/ 前缀，不受本值影响。
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 监控入口地址：默认留空，由「站点设置 → 站点信息 → 监控入口」或站点访问地址自动推导
# （Prometheus = 站点域名 + 9090，Grafana = 站点域名 + 3001，Actuator = 同源 /manage/actuator）
# 只有需要固定指向别的域名时才在这里写死：VITE_GRAFANA_URL=https://monitor.example.com:3001
