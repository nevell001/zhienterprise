# 页面标题
VITE_APP_TITLE = 知企建站系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 博客管理系统/生产环境；博客前台 API 使用 /blog/api 前缀并由 nginx 单独代理
VITE_APP_BASE_API = '/api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 监控入口地址：默认留空，由「博客设置 → 站点信息 → 监控入口」或站点访问地址自动推导
# （Prometheus = 站点域名 + 9090，Grafana = 站点域名 + 3001，Actuator = 同源 /manage/actuator）
# 只有需要固定指向别的域名时才在这里写死：VITE_GRAFANA_URL=https://monitor.example.com:3001
